diff --git a/src/WallpaperEngine/Render/Shaders/Compatibility.h b/src/WallpaperEngine/Render/Shaders/Compatibility.h
new file mode 100644
index 0000000..55d18af
--- /dev/null
+++ b/src/WallpaperEngine/Render/Shaders/Compatibility.h
@@ -0,0 +1,54 @@
+#pragma once
+#include <regex>
+#include <string>
+
+namespace WallpaperEngine::Render::Shaders {
+// Called only after preprocessing, so inactive #if branches cannot change the
+// interface. Keep the vertex interface and convert to the fragment's local type.
+inline std::string matchVectorInputs (const std::string& vertex, std::string fragment) {
+    const std::regex output (R"(\bout\s+(?:highp\s+|mediump\s+|lowp\s+)?vec([234])\s+([A-Za-z_]\w*)\s*;)");
+    for (auto it = std::sregex_iterator (vertex.begin (), vertex.end (), output);
+         it != std::sregex_iterator (); ++it) {
+        const std::string name = (*it)[2];
+        const int width = std::stoi ((*it)[1]);
+        const std::regex input ("\\bin\\s+(?:highp\\s+|mediump\\s+|lowp\\s+)?vec([234])\\s+" + name + "\\s*;");
+        std::smatch match;
+        if (!std::regex_search (fragment, match, input)) continue;
+        const int expected = std::stoi (match[1]);
+        if (expected == width) continue;
+        std::string local = "we_local_" + name;
+        while (fragment.find (local) != std::string::npos) local += "_";
+        fragment = std::regex_replace (fragment, std::regex ("\\b" + name + "\\b"), local);
+        const std::regex localDeclaration ("\\bin\\s+(?:highp\\s+|mediump\\s+|lowp\\s+)?vec[234]\\s+" + local + "\\s*;");
+        fragment = std::regex_replace (fragment, localDeclaration,
+            "in vec" + std::to_string (width) + " " + name + ";\nvec" + std::to_string (expected) + " " + local + ";");
+        std::string conversion = name;
+        if (width > expected) conversion += "." + std::string ("xyzw", expected);
+        else {
+            conversion = "vec" + std::to_string (expected) + "(" + name;
+            for (int i = width; i < expected; ++i) conversion += i == 3 ? ", 1.0" : ", 0.0";
+            conversion += ")";
+        }
+        fragment = std::regex_replace (fragment, std::regex (R"(\bvoid\s+main\s*\(\s*(?:void\s*)?\)\s*\{)"),
+            "$&\n" + local + " = " + conversion + ";", std::regex_constants::format_first_only);
+    }
+    return fragment;
+}
+// HLSL permits assigning to interpolated parameters. GLSL fragment inputs are
+// read-only: keep the interface name and redirect uses to a per-fragment copy.
+inline std::string writableTexCoord (std::string source) {
+    const std::regex assignment (R"(\bv_TexCoord(?:\.[xyzwrgba]{1,4})?\s*(?:[+*/-]?=(?!=)|\+\+|--))");
+    const std::regex declaration (R"(\bvarying\s+(vec[234])\s+v_TexCoord\s*;)");
+    const std::regex mainFunction (R"(\bvoid\s+main\s*\(\s*(?:void\s*)?\)\s*\{)");
+    std::smatch match;
+    if (!std::regex_search (source, assignment) || !std::regex_search (source, match, declaration)
+        || !std::regex_search (source, mainFunction)) {
+        return source;
+    }
+    source = std::regex_replace (source, std::regex (R"(\bv_TexCoord\b)"), "we_localTexCoord");
+    source = std::regex_replace (source, std::regex (R"(\bvarying\s+(vec[234])\s+we_localTexCoord\s*;)"),
+                                "varying $1 v_TexCoord;\n$1 we_localTexCoord;");
+    return std::regex_replace (source, mainFunction, "$&\nwe_localTexCoord = v_TexCoord;",
+                               std::regex_constants::format_first_only);
+}
+}
diff --git a/src/WallpaperEngine/Render/Helpers/Blending.h b/src/WallpaperEngine/Render/Helpers/Blending.h
new file mode 100644
index 0000000..b561ee5
--- /dev/null
+++ b/src/WallpaperEngine/Render/Helpers/Blending.h
@@ -0,0 +1,13 @@
+#pragma once
+
+#include <GL/glew.h>
+
+namespace WallpaperEngine::Render::Helpers {
+// RGB uses straight source alpha. Coverage must use source-over rather than
+// multiplying the source alpha by itself, which erodes intermediate masks.
+inline void setupTranslucentBlending () {
+    glEnable (GL_BLEND);
+    glBlendEquationSeparate (GL_FUNC_ADD, GL_FUNC_ADD);
+    glBlendFuncSeparate (GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA, GL_ONE, GL_ONE_MINUS_SRC_ALPHA);
+}
+}
