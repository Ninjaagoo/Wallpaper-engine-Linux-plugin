     this->m_final
 	+= this->applyFragmentTexCoordCompatibility (this->applyLinkedVaryingCompatibility (this->m_preprocessed));
 
+    // Some Workshop shaders use HLSL identifiers that are reserved in GLSL.
+    this->m_final = std::regex_replace (this->m_final, std::regex (R"(\binput\b)"), "we_shaderInput");
