 TextUniquePtr ObjectParser::parseText (const JSON& it, const Project& project, ObjectData base) {
+    // Scene files store horizontal/vertical padding as a vector string. Older
+    // files can use a scalar, which applies to both axes.
+    glm::vec2 padding (0.0f);
+    if (const auto value = it.optional ("padding")) {
+	padding = value->is_number () ? glm::vec2 (value->get<float> ())
+	                             : Builders::VectorBuilder::parse<2, float, glm::defaultp> (value->get<std::string> ());
+    }
     return std::make_unique<Text> (
 	std::move (base),
 	TextData {
@@ -136,7 +143,7 @@ TextUniquePtr ObjectParser::parseText (const JSON& it, const Project& project, O
